<UserControl x:Class="Projeto_Lab.EditAluno"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="300" Width="400"
             Loaded="UserControl_Loaded">

    <Grid Background="Transparent" Margin="20">
        <Border Background="#23272A" CornerRadius="15" Padding="20">
            <Grid Margin="0,0,0,-6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Editar Aluno"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Left"/>

                <!-- Número (desativado) -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Número:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         x:Name="tbNumero"
                         Height="30"
                         Margin="0,5"
                         Background="#1E1F22"
                         BorderBrush="#40444B"
                         Foreground="White"
                         IsEnabled="False"
                         Padding="6"/>

                <!-- Nome -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Nome:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="tbNome"
                         Height="30"
                         Margin="0,5"
                         Background="#1E1F22"
                         BorderBrush="#40444B"
                         Foreground="White"
                         Padding="6"/>

                <!-- Email -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Email:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         x:Name="tbEmail"
                         Height="30"
                         Margin="0,5"
                         Background="#1E1F22"
                         BorderBrush="#40444B"
                         Foreground="White"
                         Padding="6" IsEnabled="False"/>

                <!-- Botão -->
                <Border Grid.Row="5" Grid.ColumnSpan="2"
                        Background="#7289DA"
                        CornerRadius="10"
                        Height="40"
                        Margin="0,20,0,0"
                        Width="140"
                        HorizontalAlignment="Left">
                    <Button x:Name="btn_save"
                            Content="Editar Aluno"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            FontSize="12"
                            Cursor="Hand"
                            Click="btn_Adicionar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5B6EAE"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#47568C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
