<UserControl x:Class="Projeto_Lab.NotaGlobal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2B2D31"
             Height="200"
             Width="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Atribuir Nota Global"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Caixa com TextBox + Botão -->
        <Border Grid.Row="1"
                Background="#FF23272A"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <!-- TextBox -->
                <Grid>
                    <TextBox x:Name="tb_notaGlobal"
                             Height="30"
                             FontSize="14"
                             Background="#1E1F22"
                             Foreground="White"
                             BorderBrush="#444"
                             TextChanged="tb_notaGlobal_TextChanged"/>

                    <TextBlock x:Name="tb_placeholder"
                               Text="Nota"
                               Foreground="#777"
                               FontSize="14"
                               Margin="5,5,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Padding="5,0,0,0"
                               Visibility="Visible"/>
                </Grid>

                <!-- Botão com cantos arredondados -->
                <Border Background="#7289DA"
                        CornerRadius="10"
                        Height="35"
                        Margin="0,10,0,0">
                    <Button Content="Aplicar Nota"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="AplicarNota_Click"
                            VerticalContentAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
