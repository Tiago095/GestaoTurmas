<UserControl x:Class="Projeto_Lab.AdicionarNotas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2B2D31"
             Loaded="UserControl_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Adicionar Notas"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"/>
            <TextBlock Text="Selecione o grupo e a tarefa, depois atribua as notas."
                       Foreground="#AAAAAA"
                       FontSize="12"
                       Margin="0,4,0,6"/>
        </StackPanel>

        <!-- StackPanel com fundo arredondado -->
        <Border Grid.Row="1"
                Background="#FF23272A"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox x:Name="cb_grupos"
                          Width="200"
                          Height="35"
                          Margin="0,0,20,0"
                          Background="#1E1F22"
                          Foreground="Black"
                          BorderBrush="#1E1F22"
                          FontSize="14"/>

                <ComboBox x:Name="cb_tarefas"
                          Width="200"
                          Height="35"
                          Margin="0,0,20,0"
                          Background="#1E1F22"
                          Foreground="Black"
                          BorderBrush="#1E1F22"
                          FontSize="14"/>

                <Border Background="#7289DA"
                        CornerRadius="10"
                        Height="35"
                        Width="100"
                        Margin="0,0,20,0">
                    <Button x:Name="btn_individual"
                            Content="Notas Individuais"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            Click="btn_individual_Click"/>
                </Border>

                <Border Background="#7289DA"
                        CornerRadius="10"
                        Width="100"
                        Height="35"
                        Margin="0,0,20,0">
                    <Button x:Name="btn_global"
                            Content="Nota Global"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            Click="btn_global_Click"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Conteúdo dinâmico -->
        <ContentControl x:Name="content_notas"
                        Grid.Row="2"
                        Background="#1E1F22"/>
    </Grid>
</UserControl>
