<UserControl x:Class="Projeto_Lab.NotasIndividuais"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="500"
             Width="400"
             Background="#2B2D31">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Atribuir Notas Individuais"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Border geral -->
        <Border Grid.Row="1"
                Background="#FF23272A"
                CornerRadius="12"
                Padding="10"
                Margin="0,10,0,0">
            <StackPanel Orientation="Vertical" VerticalAlignment="Stretch">

                <!-- Lista de alunos -->
                <ListView x:Name="lv_alunos"
                          Background="#23272A"
                          Foreground="White"
                          BorderThickness="0"
                          Height="250"
                          SelectionMode="Single"
                          Margin="0,0,0,40">
                    <!-- Rebaixamento -->
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#2B2D31"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="#1E1F22"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#7289DA"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2F3136"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        
                        <GridView>
                            <GridViewColumn Header="Número" Width="80" DisplayMemberBinding="{Binding Numero}"/>
                            <GridViewColumn Header="Nome" Width="200" DisplayMemberBinding="{Binding Nome}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- TextBox com placeholder -->
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="tb_nota"
                             Height="30"
                             FontSize="14"
                             Background="#1E1F22"
                             Foreground="White"
                             BorderBrush="#444"
                             TextChanged="tb_nota_TextChanged"/>
                    <TextBlock x:Name="tb_placeholder"
                               Text="Nota"
                               Foreground="#777"
                               FontSize="14"
                               Margin="5,5,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Padding="5,0,0,0"
                               Visibility="Visible"/>
                </Grid>

                <!-- Botão com cantos arredondados -->
                <Button Content="Atribuir Nota"
                        Height="35"
                        Background="#7289DA"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        BorderBrush="#7289DA"
                        Click="AtribuirNota_Click"
                        Margin="0,0,0,5">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
