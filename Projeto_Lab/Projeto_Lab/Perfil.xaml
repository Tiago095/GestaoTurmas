<UserControl x:Class="Projeto_Lab.Perfil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2B2D31"
             Height="500" Width="800"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título e Subtítulo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PERFIL"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Visualização do perfil"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Conteúdo com borda arredondada -->
        <Border Grid.Row="1"
                Background="#1E1F22"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Foto de Perfil -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Height="204">
                    <Border Width="150" Height="150" Background="#444" CornerRadius="75">
                        <Grid>
                            <!-- Iniciais -->
                            <TextBlock x:Name="ProfileInitials"
                                       Text="QH"
                                       FontSize="48"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Visible"/>
                            <!-- Imagem -->
                            <Image x:Name="ImagemPerfil"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Botão Alterar Foto -->
                    <Button x:Name="btn_foto"
                            Content="Alterar Foto"
                            Margin="0,19,0,0"
                            Width="130"
                            Height="35"
                            FontSize="14"
                            Foreground="White"
                            Background="#FF57F287"
                            BorderBrush="#FF57F287"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btn_foto_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3AB870"/>
                                        <Setter Property="BorderBrush" Value="#FF3AB870"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Formulário -->
                <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Nome"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="tb_nome_"
                             Height="30"
                             Background="#FF1E1F22"
                             Foreground="White"
                             BorderBrush="#FF828790"
                             BorderThickness="1"/>

                    <TextBlock Text="Email"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,20,0,5"/>
                    <TextBox x:Name="tb_email"
                             Height="30"
                             Background="#FF1E1F22"
                             Foreground="White"
                             BorderBrush="#FF828790"
                             BorderThickness="1"/>

                    <!-- Botões: Salvar e Remover Dados -->
                    <StackPanel Orientation="Horizontal" Margin="0,42,0,0" HorizontalAlignment="Left">
                        <!-- Botão Salvar -->
                        <Button x:Name="bnt_salvar"
                                Content="Salvar"
                                Width="130"
                                Height="35"
                                FontSize="14"
                                Foreground="White"
                                Background="#FF57F287"
                                BorderBrush="#FF57F287"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="bnt_salvar_Click"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF3AB870"/>
                                            <Setter Property="BorderBrush" Value="#FF3AB870"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Botão Remover Dados -->
                        <Button x:Name="btn_remover"
                                Content="Remover Dados"
                                Width="130"
                                Height="35"
                                FontSize="14"
                                Foreground="White"
                                Background="#FFF25757"
                                BorderBrush="#FFF25757"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btn_remover_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFB03A3A"/>
                                            <Setter Property="BorderBrush" Value="#FFB03A3A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
