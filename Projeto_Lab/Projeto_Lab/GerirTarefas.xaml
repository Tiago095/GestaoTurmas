<UserControl x:Class="Projeto_Lab.GerirTarefas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="#2B2D31"
             Height="Auto" Width="Auto">

    <Grid Background="#2B2D31" Margin="20,35,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título e Subtítulo -->
        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Gerir Tarefas"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"/>
            <TextBlock Text="Adicione, edite ou remova tarefas atribuídas."
                       Foreground="#AAAAAA"
                       FontSize="12"
                       Margin="0,4,0,6"/>
        </StackPanel>

        <!-- Conteúdo principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Painel com Search, ListView e botões -->
            <Border Grid.ColumnSpan="2" Background="#23272A" CornerRadius="15" Margin="0,0,5,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de pesquisa por ID -->
                    <Border Background="#1E1F22" CornerRadius="10" Padding="10" Margin="0,0,10,10"
                            Grid.Column="0" Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtPesquisaTarefa" Width="200" Height="28" FontSize="13" Padding="5"
                                     VerticalContentAlignment="Center" Background="#2C2F33" Foreground="White"
                                     BorderThickness="0"
                                     TextChanged="txtPesquisaTarefa_TextChanged"/>
                            <Button Content="Limpar" Height="28" FontSize="13" Padding="10,0" Background="#7289DA"
                                    Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"
                                    Click="btnLimparPesquisa_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ListView de Tarefas -->
                    <ListView x:Name="lv_tarefas"
                              Grid.Column="0"
                              Grid.Row="1"
                              Margin="0,0,10,0"
                              Background="#2C2F33"
                              Foreground="White"
                              BorderThickness="0"
                              FontSize="14"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#2B2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="#1E1F22"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#7289DA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2F3136"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="Título" DisplayMemberBinding="{Binding Titulo}" Width="150"/>
                                <GridViewColumn Header="Descrição" DisplayMemberBinding="{Binding Descricao}" Width="200"/>
                                <GridViewColumn Header="Data Início">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataHoraInicio, StringFormat='dd/MM/yyyy'}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Data Fim">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataHoraTermino, StringFormat='dd/MM/yyyy'}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Peso" DisplayMemberBinding="{Binding Peso}" Width="50"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Botões -->
                    <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top">
                        <Border Background="#7289DA" CornerRadius="10" Height="40" Margin="0,0,0,10">
                            <Button x:Name="btn_adicionar"
                                    Content="Adicionar Tarefa"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btn_adicionar_Click"/>
                        </Border>

                        <Border Background="#7289DA" CornerRadius="10" Height="40" Margin="0,0,0,10">
                            <Button x:Name="btn_editar"
                                    Content="Editar Tarefa"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btn_editar_Click"/>
                        </Border>

                        <Border Background="#7289DA" CornerRadius="10" Height="40">
                            <Button x:Name="btn_remover"
                                    Content="Remover Tarefa"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btn_remover_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ContentControl para carregar views adicionais -->
            <ContentControl x:Name="TarefasContent" Grid.ColumnSpan="2"/>
        </Grid>
    </Grid>
</UserControl>
