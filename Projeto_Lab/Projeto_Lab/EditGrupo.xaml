<UserControl x:Class="Projeto_Lab.EditGrupo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="#2B2D31" Loaded="UserControl_Loaded">

    <Grid Margin="10">
        <Border CornerRadius="20" Background="#23272A" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ID do Grupo" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_id" Background="#2C2F33" Foreground="White" BorderBrush="#FF40444B"
                         Grid.Row="0" Margin="128,5,5,5" Padding="5" Grid.ColumnSpan="2" IsEnabled="False"/>

                <TextBlock Text="Nome do Grupo" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_nome" Background="#2C2F33" Foreground="White" BorderBrush="#FF40444B"
                         Grid.Row="1" Margin="128,5,5,5" Padding="5" Grid.ColumnSpan="2"/>

                <TextBlock Text="Número de Alunos" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_num" Background="#2C2F33" Foreground="White" BorderBrush="#FF40444B"
                         Grid.Row="2" Margin="128,5,5,5" Padding="5,6,5,5" Grid.ColumnSpan="2" IsEnabled="False"/>

                <TabControl Grid.Row="3" Grid.ColumnSpan="2" Margin="5" Background="#2C2F33" BorderBrush="#FF40444B"
                            Foreground="White" Height="300">

                    <TabItem Header="Alunos no Grupo">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
                                <TextBox x:Name="txtPesquisaGrupo" Width="200" Height="28" FontSize="13" Padding="5"
                                         VerticalContentAlignment="Center" Background="#1E1F22" Foreground="White"
                                         BorderThickness="0" TextChanged="txtPesquisaGrupo_TextChanged"/>

                                <ComboBox x:Name="cbFiltroGrupo" Width="120" Height="28" SelectedIndex="0" FontSize="13" Padding="4"
                                          VerticalContentAlignment="Center" Background="#1E1F22" Foreground="Black"
                                          BorderThickness="0" Margin="5,0,0,0">
                                    <ComboBoxItem Content="Número"/>
                                    <ComboBoxItem Content="Nome"/>
                                </ComboBox>

                                <Button Content="Limpar" Height="28" FontSize="13" Padding="10,0" Background="#7289DA"
                                        Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"
                                        Click="btnLimparGrupo_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <ListView x:Name="lv_alunosGrupo" Background="#2C2F33" Foreground="White" BorderBrush="#FF40444B"
                                          Margin="5" SelectionMode="Extended" Grid.ColumnSpan="2">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Número" Width="70" DisplayMemberBinding="{Binding Numero}" />
                                            <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Nome}" />
                                        </GridView>
                                    </ListView.View>
                                    <ListView.Resources>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="#2B2D31"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="#1E1F22"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#7289DA"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2F3136"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.Resources>
                                </ListView>

                                <Button x:Name="btn_remove" Content="–" Click="BtnRemover_Click" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                        Background="#ED4245" Foreground="White" FontWeight="Bold" FontSize="16"
                                        BorderThickness="0" Cursor="Hand" Padding="1,-11,1,0" Grid.Column="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Alunos Disponíveis">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
                                <TextBox x:Name="txtPesquisaDisponiveis" Width="200" Height="28" FontSize="13" Padding="5"
                                         VerticalContentAlignment="Center" Background="#1E1F22" Foreground="White"
                                         BorderThickness="0" TextChanged="txtPesquisaDisponiveis_TextChanged"/>

                                <ComboBox x:Name="cbFiltroDisponiveis" Width="120" Height="28" SelectedIndex="0" FontSize="13" Padding="4"
                                          VerticalContentAlignment="Center" Background="#1E1F22" Foreground="Black"
                                          BorderThickness="0" Margin="5,0,0,0">
                                    <ComboBoxItem Content="Número"/>
                                    <ComboBoxItem Content="Nome"/>
                                </ComboBox>

                                <Button Content="Limpar" Height="28" FontSize="13" Padding="10,0" Background="#7289DA"
                                        Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"
                                        Click="btnLimparDisponiveis_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <ListView x:Name="lv_alunosDisponiveis" Background="#2C2F33" Foreground="White" BorderBrush="#FF40444B"
                                          Margin="5" SelectionMode="Extended">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Número" Width="70" DisplayMemberBinding="{Binding Numero}" />
                                            <GridViewColumn Header="Nome" Width="150" DisplayMemberBinding="{Binding Nome}" />
                                        </GridView>
                                    </ListView.View>
                                    <ListView.Resources>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="#2B2D31"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="#1E1F22"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#7289DA"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2F3136"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.Resources>
                                </ListView>

                                <Button x:Name="btn_add" Content="+" Click="BtnAdicionar_Click" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                        Background="#FF43B581" Foreground="White" FontWeight="Bold" FontSize="16"
                                        BorderThickness="0" Cursor="Hand" Padding="1,1,1,1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Button Content="Voltar"
                        Grid.Row="4" Grid.ColumnSpan="2"
                        Background="#FF7289DA" Foreground="White" FontWeight="Bold"
                        Margin="5" Height="40" Width="200" HorizontalAlignment="Center"
                        Click="btn_guardar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
