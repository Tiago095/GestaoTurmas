<UserControl x:Class="Projeto_Lab.AddTarefa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800"
             Background="#2B2D31">
    <Grid>
        <Border Background="#23272A"
                CornerRadius="20"
                Padding="30"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Width="400" HorizontalAlignment="Center">

                <!-- Título da tela -->
                <TextBlock Text="Adicionar Tarefa"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Campo: Título e ID lado a lado -->
                <TextBlock Text="ID e Título:" Foreground="White" FontWeight="SemiBold" Margin="0,-20,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- TextBox Título -->
                    <TextBox x:Name="tb_id"
                             Grid.Column="0"
                             Height="30"
                             Background="#2C2F33"
                             Foreground="White"
                             BorderBrush="#FF828790"
                             BorderThickness="1"
                             Margin="0,0,125,0"/>

                    <!-- TextBox ID -->
                    <TextBox x:Name="tb_titulo"
                             Height="30"
                             Background="#2C2F33"
                             Foreground="White"
                             BorderBrush="#FF828790"
                             BorderThickness="1" Grid.ColumnSpan="2" Margin="147,0,0,0"/>
                </Grid>

                <!-- Campo: Descrição -->
                <TextBlock Text="Descrição:" Foreground="White" FontWeight="SemiBold" Margin="0,-10,0,5"/>
                <TextBox x:Name="tb_descricao"
                         Height="60"
                         Background="#2C2F33"
                         Foreground="White"
                         BorderBrush="#FF828790"
                         BorderThickness="1"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,10"/>

                <!-- Campo: Peso (com Slider) -->
                <TextBlock Text="Peso:" Foreground="White" FontWeight="SemiBold" Margin="0,-5,0,5"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-5,0,10">
                    <Slider x:Name="sldPeso"
                            Minimum="1"
                            Maximum="100"
                            Value="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="300"
                            Background="#2C2F33"
                            Foreground="White"
                            BorderBrush="#7289DA"/>
                    <TextBlock Text="{Binding ElementName=sldPeso, Path=Value}"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Campo: Data Início -->
                <TextBlock Text="Data de Início:" Foreground="White" FontWeight="SemiBold" Margin="0,-5,0,5"/>
                <DatePicker x:Name="dpInicio"
                            Height="30"
                            Background="#2C2F33"
                            Foreground="#FF828790"
                            BorderBrush="#FF828790"
                            BorderThickness="1"
                            Margin="0,0,0,10"/>

                <!-- Campo: Data Fim -->
                <TextBlock Text="Data de Fim:" Foreground="White" FontWeight="SemiBold" Margin="0,-5,0,5"/>
                <DatePicker x:Name="dpFim"
                            Height="30"
                            Background="#2C2F33"
                            Foreground="#FF828790"
                            BorderBrush="#FF828790"
                            BorderThickness="1"
                            Margin="0,0,0,20"/>

                <!-- Botão de Adicionar -->
                <Border Background="#7289DA" CornerRadius="10" Height="40" Width="180" HorizontalAlignment="Center" Margin="0,-15,0,10">
                    <Button x:Name="btnAdicionar"
                            Content="Adicionar Tarefa"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Padding="0"
                            Click="btnAdicionar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5B6EAE"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#47568C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
