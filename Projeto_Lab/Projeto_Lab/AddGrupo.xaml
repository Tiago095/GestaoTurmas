<UserControl x:Class="Projeto_Lab.AddGrupo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="#2B2D31" Loaded="UserControl_Loaded">

    <Grid Margin="10">
        <Border CornerRadius="20" Background="#23272A" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ID do Grupo" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_id" Background="#2C2F33" Foreground="White" BorderBrush="#FF828790"
                         Grid.Row="0" Grid.Column="1" Margin="5" Padding="5"/>

                <TextBlock Text="Nome do Grupo" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_nome" Background="#2C2F33" Foreground="White" BorderBrush="#FF828790"
                         Grid.Row="1" Grid.Column="1" Margin="5" Padding="5"/>

                <TextBlock Text="Número de Alunos" Foreground="White" Grid.Row="2" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="tb_num" Background="#2C2F33" Foreground="White" BorderBrush="#FF828790"
                         Grid.Row="2" Grid.Column="1" Margin="5" Padding="5"/>

                <TextBlock Text="Selecionar Alunos" Foreground="White" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Top"/>

                <Grid Grid.Row="3" Grid.Column="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1E1F22" CornerRadius="10" Padding="10" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtPesquisa" Width="200" Height="28" FontSize="13" Padding="5"
                                     VerticalContentAlignment="Center" Background="#2C2F33" Foreground="White"
                                     BorderThickness="0" TextChanged="txtPesquisa_TextChanged"/>
                            <ComboBox x:Name="cbFiltro" Width="120" Height="28" SelectedIndex="0" FontSize="13" Padding="4"
                                      VerticalContentAlignment="Center" Background="#2C2F33" Foreground="Black"
                                      BorderThickness="0" Margin="5,0,0,0">
                                <ComboBoxItem Content="Número"/>
                                <ComboBoxItem Content="Nome"/>
                            </ComboBox>
                            <Button Content="Limpar" Height="28" FontSize="13" Padding="10,0" Background="#7289DA"
                                    Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0"
                                    Click="btnLimpar_Click"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="lv_alunos" SelectionMode="Multiple" Background="#2C2F33" Foreground="White" BorderBrush="#FF828790"
                              Grid.Row="1" Height="150">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#2B2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="#1E1F22"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#7289DA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2F3136"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Numero" Width="70" DisplayMemberBinding="{Binding Numero}"/>
                                <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Nome}"/>
                                <GridViewColumn Header="Email" Width="150" DisplayMemberBinding="{Binding Email}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <Border BorderBrush="#FF7289DA"
                        Background="#7289DA"
                        CornerRadius="10"
                        Height="40"
                        Width="200"
                        Margin="5"
                        HorizontalAlignment="Center"
                        Grid.Row="4"
                        Grid.ColumnSpan="2">
                    <Button x:Name="btn_add" Content="Adicionar Grupo"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" Click="btn_add_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5B6EAE"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#47568C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
