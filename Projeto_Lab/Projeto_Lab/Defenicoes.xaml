<UserControl x:Class="Projeto_Lab.Defenicoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Background="#2B2D31" Margin="20">
        <!-- Separador -->
        <Separator Margin="0,0,0,10" Background="Gray" Height="1"/>

        <!-- Apagar Turma -->
        <StackPanel Margin="0,0,0,30">
            <TextBlock Text="Apagar Turma" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

            <TextBlock Text="Selecionar Turma:" Foreground="White"/>
            <ComboBox x:Name="cb_turmas" Width="200" Margin="0,5" Background="White" Foreground="Black"/>

            <Border Background="#ED4245" CornerRadius="10" Width="100" Margin="0,20,0,0">
                <Button x:Name="btn_apagar" Content="Apagar" Background="Transparent" Foreground="White" BorderThickness="0" Height="31" Click="btn_apagar_Click" />
            </Border>
        </StackPanel>

        <!-- Separador -->
        <Separator Margin="0,0,0,10" Background="Gray" Height="12" RenderTransformOrigin="0.5,0.5">
            <Separator.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Separator.RenderTransform>
        </Separator>

        <!-- Ajuda -->
        <StackPanel Margin="0,0,0,30">
            <TextBlock Text="Centro de Ajuda" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="White">
                Aqui pode encontrar respostas às perguntas mais frequentes, manuais de utilizador ou contactar suporte técnico.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="White">
                1. Cada linha do ficheiro aluno .csv/.xlsv deve ter o formato " NOME,NUMERO,EMAIL "
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="White">
                2. Os ficheiros tarefas e alunos devem ser ficheiros .txt e o seu formato é Tarefas - " Id;Título;Descrição;DataInicio;DataFim;Peso " / Grupo - " Id;Nome;NumerodeAlunos;aluno(numero),aluno,..."
            </TextBlock>

            <Border Background="#FF7289DA" CornerRadius="10" Width="150" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Separador -->
        <Separator Margin="0,0,0,10" Background="Gray" Height="18" RenderTransformOrigin="0.5,0.5">
            <Separator.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Separator.RenderTransform>
        </Separator>

        <!-- Sobre -->
        <StackPanel>
            <TextBlock Text="Sobre a Aplicação" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="White" Height="35">
                Esta aplicação foi desenvolvida para facilitar a gestão escolar, incluindo funcionalidades de organização de turmas, alunos e grupos. Programada por: Tiago Ribeiro , André Marques , Francisco Rodrigues
            </TextBlock>
            <TextBlock Margin="0,15,0,0" FontStyle="Italic" Foreground="#AAAAAA">
                Versão: 1.0.0
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
