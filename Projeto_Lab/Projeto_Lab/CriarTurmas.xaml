<UserControl x:Class="Projeto_Lab.CriarTurma"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Lab"
             mc:Ignorable="d"
             Background="#2B2D31" Width="528" Height="500">

    <StackPanel Margin="30" VerticalAlignment="Center">
        <!-- Título e Subtítulo -->
        <TextBlock Text="Criar Nova Turma" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   />
        <TextBlock Text="Configure os ficheiros e definições da turma" 
                   Foreground="Gray" 
                   FontSize="14" 
                   Margin="0,10,0,10"
                   />

        <!-- Quadrado com cantos redondos -->
        <Border CornerRadius="20" 
                Background="#23272A" 
                Padding="30" Height="365">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Ficheiro Alunos -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ficheiro Alunos:"
                           Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="tb_a" Grid.Row="1" Grid.Column="0" Height="32" Margin="0,0,10,20"
                         Background="#1E1F22" Foreground="White" BorderThickness="1" BorderBrush="#40444B" IsEnabled="False"/>
                <Button x:Name="btn_a" Grid.Row="1" Grid.Column="1" Content="Abrir" Height="32" Margin="0,0,0,20"
                        Background="#7289DA" Foreground="White" Click="btn_a_Click" BorderBrush="#FF7289DA"/>

                <!-- Ficheiro Tarefas -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ficheiro Tarefas:"
                           Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="tb_t" Grid.Row="3" Grid.Column="0" Height="32" Margin="0,0,10,20"
                         Background="#1E1F22" Foreground="White" BorderThickness="1" BorderBrush="#40444B" IsEnabled="False"/>
                <Button x:Name="btn_t" Grid.Row="3" Grid.Column="1" Content="Abrir" Height="32" Margin="0,0,0,20"
                        Background="#7289DA" Foreground="White" Click="btn_t_Click" BorderBrush="#FF7289DA"/>

                <!-- Ficheiro Grupos -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ficheiro Grupos:"
                           Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="tb_g" Grid.Row="5" Grid.Column="0" Height="32" Margin="0,0,10,20"
                         Background="#1E1F22" Foreground="White" BorderThickness="1" BorderBrush="#40444B" IsEnabled="False"/>
                <Button x:Name="btn_gr" Grid.Row="5" Grid.Column="1" Content="Abrir" Height="32" Margin="0,0,0,20"
                        Background="#7289DA" Foreground="White" Click="btn_gr_Click" BorderBrush="#FF7289DA"/>

                <!-- ID da Turma -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="ID da Turma:"
                           Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <TextBox x:Name="id" Grid.Row="7" Grid.Column="0" Height="32" Margin="0,0,10,0"
                         Background="#1E1F22" Foreground="White" BorderThickness="1" BorderBrush="#40444B"/>

                <!-- Botão Salvar -->
                <Button x:Name="btn_salvar" Grid.Row="7" Grid.Column="1" Content="Salvar"
                        Height="32" Background="#57F287" Foreground="White" Click="btn_salvar_Click" BorderBrush="#FF57F287"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>